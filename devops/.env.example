# Copy to .env and adjust.

# SonarQube's Postgres database
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar

# Linux only: the host's docker group GID, so the Jenkins container can
# talk to the mounted /var/run/docker.sock. Find it with:
#   getent group docker | cut -d: -f3
# (On Docker Desktop for Windows/Mac this isn't needed; leave the default.)
DOCKER_GID=999
